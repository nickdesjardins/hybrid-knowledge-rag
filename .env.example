# Copy to .env and fill in the keys you have. Every value has a sane default in app/config.py.

# ----------------------------------------------------------------- application
APP_NAME=hybrid-retrieval-engine
ENVIRONMENT=development
LOG_LEVEL=INFO
# Optional shared secret. When set, /api/v1/ingest and /api/v1/query require header X-API-Key.
API_KEY=

# -------------------------------------------------------------------- database
# Matches docker-compose.yml defaults. Change POSTGRES_PASSWORD before exposing the port.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_PORT=5432
# Compose binds Postgres and the API to 127.0.0.1 unless you override these.
POSTGRES_BIND=127.0.0.1
API_BIND=127.0.0.1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_S=10
HEALTH_TIMEOUT_S=5
DB_ECHO=false
AUTO_CREATE_SCHEMA=true

# ------------------------------------------------------------------ embeddings
# openai (default) | fastembed (local ONNX) | hashing (offline demo only, not semantic)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CONCURRENCY=4
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5   # 384 dims -> set EMBEDDING_DIMENSIONS=384

# ------------------------------------------------------------------ generation
# anthropic (default) | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-opus-5-5
GENERATION_EFFORT=low
# Thinking counts toward this budget on Claude 5.x; max 16000 (non-streaming SDK limit).
GENERATION_MAX_TOKENS=4096
# Only sent to providers that accept sampling parameters (OpenAI). Claude 5.x rejects them.
# Leave empty to omit the parameter entirely (e.g. for OpenAI reasoning models).
GENERATION_TEMPERATURE=0.0
OPENAI_GENERATION_MODEL=gpt-4.1

# -------------------------------------------------------------- contextualizer
CONTEXTUALIZER_ENABLED=true
CONTEXTUALIZER_MODEL=claude-haiku-5-5
CONTEXTUALIZER_MAX_TOKENS=2048
CONTEXTUALIZER_CONCURRENCY=8
CONTEXTUALIZER_DOC_MAX_CHARS=120000

# ------------------------------------------------------------------- reranking
# cohere (default) | none (keep RRF order; degraded)
RERANK_PROVIDER=cohere
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# ------------------------------------------------------------------- retrieval
RRF_K=60
TOP_K_RETRIEVAL=50
TOP_K_RERANK=3
# Build-time HNSW parameters (applied when the index is first created). pgvector requires
# HNSW_EF_CONSTRUCTION >= 2 * HNSW_M.
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=100
HNSW_ITERATIVE_SCAN=relaxed_order

# -------------------------------------------------------------------- chunking
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=500
MAX_CHUNKS_PER_DOCUMENT=2000
