# Copy to .env and fill in the keys you have. Every value has a sane default in app/config.py.
# Zero-cost setup (OpenRouter free models + local models): see the preset block at the END.

#

# ----------------------------------------------------------------- application
APP_NAME=hybrid-retrieval-engine
ENVIRONMENT=development
LOG_LEVEL=INFO
# Optional shared secret. When set, /api/v1/* requires header X-API-Key (in DEMO_MODE only
# uploads do: questions and the corpus listing stay public there).
API_KEY=
# Largest body accepted on any POST except uploads, checked before the body is parsed.
MAX_JSON_BODY_BYTES=32768

# -------------------------------------------------------------------- database
# Matches docker-compose.yml defaults. Change POSTGRES_PASSWORD before exposing the port.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
# Hosted Postgres (Neon via Vercel, Supabase, Render): paste the provider's string as it is.
# postgresql://...?sslmode=require&channel_binding=require is converted for asyncpg automatically.
# When both are set, the direct (unpooled) one is used: the app keeps its own connection pool.
DATABASE_URL_UNPOOLED=
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_PORT=5432
# Compose binds Postgres and the API to 127.0.0.1 unless you override these.
POSTGRES_BIND=127.0.0.1
API_BIND=127.0.0.1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_S=10
# Recycle pooled connections older than this (Neon suspends idle computes after 5 minutes)
DB_POOL_RECYCLE_S=240
HEALTH_TIMEOUT_S=5
# Retries of the start-up schema check while a serverless database (Neon) resumes.
DB_STARTUP_RETRIES=3
DB_ECHO=false
AUTO_CREATE_SCHEMA=true

# ------------------------------------------------------------------ embeddings
# openai (default) | openrouter (paid models via OpenRouter) | fastembed (local ONNX, free)
# | hashing (offline demo only, not semantic)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CONCURRENCY=4
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5   # 384 dims -> set EMBEDDING_DIMENSIONS=384

# ------------------------------------------------------------------ generation
# anthropic (default) | openai | openrouter (free models, see the OpenRouter section)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-opus-5-5
GENERATION_EFFORT=low
# Thinking counts toward this budget on Claude 5.x; max 16000 (non-streaming SDK limit).
GENERATION_MAX_TOKENS=4096
# Only sent to providers that accept sampling parameters (OpenAI). Claude 5.x rejects them.
# Leave empty to omit the parameter entirely (e.g. for OpenAI reasoning models).
GENERATION_TEMPERATURE=0.0
OPENAI_GENERATION_MODEL=gpt-4.1

# ------------------------------------------------------------------ openrouter
# Used when LLM_PROVIDER=openrouter, CONTEXTUALIZER_PROVIDER=openrouter or
# EMBEDDING_PROVIDER=openrouter. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ordered, comma-separated chain. First = primary; later entries are tried only when the
# earlier ones fail (429, upstream error, withdrawal, truncation, invalid JSON). The default
# is the chain the Phase 1 extraction service measured on 2026-10-07; run
# `python scripts/openrouter_smoke.py` to see whether its models are still listed.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free
OPENROUTER_CONTEXTUALIZER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free
# true = every chain entry must end in ":free" (a typo can never spend money)
OPENROUTER_FREE_ONLY=true
# true = strict json_schema first; a model that rejects it is retried in plain JSON mode
OPENROUTER_STRICT_JSON_SCHEMA=true
# OpenRouter allows 20 requests/min on free models and 50/day without credits (1000/day with
# a one-time $10 credit purchase). Request starts are paced to this value; 0 = no pacing.
OPENROUTER_REQUESTS_PER_MINUTE=20
OPENROUTER_TIMEOUT_S=60
# Only for EMBEDDING_PROVIDER=openrouter (no free embedding models exist on OpenRouter)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional attribution headers shown on openrouter.ai dashboards
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=hybrid-retrieval-engine

# -------------------------------------------------------------- contextualizer
CONTEXTUALIZER_ENABLED=true
# auto (default: the generation vendor when its key is set, else heuristic)
# | anthropic | openrouter | heuristic (offline: title, section, page - no model calls)
CONTEXTUALIZER_PROVIDER=auto
CONTEXTUALIZER_MODEL=claude-haiku-5-5
CONTEXTUALIZER_MAX_TOKENS=2048
CONTEXTUALIZER_CONCURRENCY=8
CONTEXTUALIZER_DOC_MAX_CHARS=120000
# Documents with more chunks than this get heuristic contexts (protects a 50/day allowance).
CONTEXTUALIZER_MAX_LLM_CALLS_PER_DOCUMENT=400

# ------------------------------------------------------------------- reranking
# cohere (default) | fastembed (local cross-encoder, free) | none (keep RRF order; degraded)
RERANK_PROVIDER=cohere
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
# Local cross-encoder for RERANK_PROVIDER=fastembed (Xenova/ms-marco-MiniLM-L-6-v2 ~80 MB;
# BAAI/bge-reranker-v2-m3-int8 is stronger and multilingual at ~570 MB)
FASTEMBED_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ------------------------------------------------------------------- retrieval
RRF_K=60
TOP_K_RETRIEVAL=50
TOP_K_RERANK=3
# Build-time HNSW parameters (applied when the index is first created). pgvector requires
# HNSW_EF_CONSTRUCTION >= 2 * HNSW_M.
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=100
HNSW_ITERATIVE_SCAN=relaxed_order

# -------------------------------------------------------------------- chunking
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=500
MAX_CHUNKS_PER_DOCUMENT=2000

# ------------------------------------------------------------- local model tuning
# Applies to EMBEDDING_PROVIDER=fastembed and RERANK_PROVIDER=fastembed.
# true = turn ONNX Runtime's CPU memory arena off. Measured on this project: 843 MB -> 385 MB
# steady memory for ~15% slower inference. Leave it on unless you have RAM to spare.
FASTEMBED_LOW_MEMORY=true
# ONNX intra-op threads; empty = library default (all cores). Use 1 on a fractional-CPU host.
FASTEMBED_THREADS=
FASTEMBED_RERANK_BATCH_SIZE=8
# Local model calls (embedding + re-ranking) allowed at once. 1 keeps a 512 MB host in memory.
LOCAL_INFERENCE_CONCURRENCY=1

# ----------------------------------------------------- public showcase (demo mode)
# true = uploads are closed to the public (only API_KEY holders may ingest), questions are
# open but rate limited and budgeted, and the corpus in DEMO_SEED_DIR is ingested at startup
# when the database does not hold it yet. render.yaml sets this for the deployed demo.
DEMO_MODE=false
DEMO_SEED_DIR=demo
DEMO_SEED_ON_STARTUP=true
# Serve the browser playground at / (static files, no build step)
PLAYGROUND_ENABLED=true
# Origins allowed to call the API from a browser, comma-separated (the GitHub Pages site).
# Empty = no CORS headers; * = any origin.
CORS_ALLOW_ORIGINS=
# Visitor addresses, for the per-visitor limits. Leave TRUST_PROXY_HEADERS=false when clients
# reach the app directly (they could forge the headers). Behind a reverse proxy, set it to true
# and name the header the edge overwrites (CF-Connecting-IP behind Cloudflare, as on Render);
# otherwise the X-Forwarded-For entry TRUSTED_PROXY_HOPS places from the right is used.
TRUST_PROXY_HEADERS=false
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1
# Demo-mode limits: questions per visitor per minute and per UTC day, for everyone per minute
# and per UTC day, questions answered at once, and the longest question accepted.
QUERY_RATE_LIMIT_PER_MINUTE=10
QUERY_DAILY_LIMIT_PER_CLIENT=60
QUERY_GLOBAL_LIMIT_PER_MINUTE=20
QUERY_DAILY_LIMIT=800
QUERY_MAX_INFLIGHT=4
DEMO_MAX_QUERY_CHARS=500
# Seconds the corpus listing is cached, so page views do not wake the database.
DOCUMENTS_CACHE_TTL_S=300
# Ask OpenRouter (GET /key) how many free requests are left today, at most once a minute,
# and stop answering the public when fewer than the reserve remain.
OPENROUTER_ALLOWANCE_CHECK=true
OPENROUTER_ALLOWANCE_RESERVE=50

# ===================== ZERO-COST PRESET (no Anthropic / OpenAI / Cohere keys) =====================
# Uncomment these six lines to run entirely on OpenRouter free models plus local models.
# They sit at the END of the file on purpose: in a .env file the last value of a name wins,
# so these override the section defaults above. Then: pip install -r requirements-local-models.txt
# Free endpoints may keep and train on what you send them: use sample or redacted documents.
#
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...            # https://openrouter.ai/keys
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_DIMENSIONS=384                   # BAAI/bge-small-en-v1.5; set before first ingestion
# RERANK_PROVIDER=fastembed
# CONTEXTUALIZER_PROVIDER=heuristic          # or openrouter: one free request per chunk, 50/day
# =================================================================================================

# ---------------------------------------------- hosted database (Neon via Vercel)
# Paste the two lines Vercel/Neon give you into .env.local (never into this file):
#   DATABASE_URL=postgresql://...-pooler...neon.tech/neondb?sslmode=require&channel_binding=require
#   DATABASE_URL_UNPOOLED=postgresql://...neon.tech/neondb?sslmode=require&channel_binding=require
# The app uses the unpooled one when both are present. The other variables in Vercel's block
# (PGHOST, POSTGRES_URL, POSTGRES_PRISMA_URL, ...) are not read by this project.
